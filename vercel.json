{
  "version": 2,
  "buildCommand": "node scripts/vercel-static.js",
  "functions": {
    "api/*.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=90, stale-while-revalidate=120"
        }
      ]
    }
  ],
  "outputDirectory": "public"
}
