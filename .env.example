# Para hospedar por conta própria: copie para .env e preencha no servidor.
# Nunca coloque credenciais reais no GitHub.
POSTGRES_PASSWORD=SUBSTITUA-POR-UMA-SENHA-FORTE
# A string deve usar o host 'postgres' para chegar ao serviço Docker.
DATABASE_URL=postgresql://radar:SUBSTITUA-POR-UMA-SENHA-FORTE@postgres:5432/radar
PORT=3000
